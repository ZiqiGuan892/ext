+# External modules can register into _OMNI_MODELS at import time:
+#   from vllm_omni.model_executor.models.registry import _OMNI_MODELS
+#   _OMNI_MODELS["MyArchitecture"] = ("my_model", "my_model", "MyClass")
+# Gate: off by default (env var unset = no-op), zero behavior change upstream.
+# Upstream PR plan: propose as a first-class extension point in vllm-omni.
+import os as _os
+import importlib as _importlib
+import logging as _logging
+_ext_logger = _logging.getLogger(__name__)
+for _mod in (m.strip() for m in _os.environ.get("VLLM_OMNI_EXTERNAL_MODULES", "").split(",") if m.strip()):
